<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Illustration Portfolio AI</title>
  <style>
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #f8f7f4;
      color: #111;
      text-align: center;
    }

    .hero {
      padding: 100px 20px;
    }

    h1 {
      font-size: 48px;
      margin-bottom: 20px;
    }

    p {
      font-size: 18px;
      max-width: 600px;
      margin: 0 auto 30px;
      line-height: 1.6;
      color: #555;
    }

    .btn {
      display: inline-block;
      padding: 14px 28px;
      background: black;
      color: white;
      text-decoration: none;
      border-radius: 30px;
      font-size: 16px;
      transition: 0.3s;
    }

    .btn:hover {
      background: #333;
    }

    .section {
      padding: 80px 20px;
      background: white;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      max-width: 900px;
      margin: 40px auto 0;
    }

    .card {
      background: #eee;
      height: 200px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #888;
      font-size: 14px;
    }

    footer {
      padding: 40px 20px;
      font-size: 14px;
      color: #777;
    }
  </style>
</head>

<body>

  <div class="hero">
    <h1>Illustration Portfolio AI</h1>
    <p>
      An intelligent portfolio tool designed for illustration,
      game art and creative design students.
      Build, organize and present your projects beautifully.
    </p>
    <a href="#" class="btn">Start Building</a>
  </div>

  <div class="section">
    <h2>Featured Projects</h2>
    <div class="grid">
      <div class="card">Project 01</div>
      <div class="card">Project 02</div>
      <div class="card">Project 03</div>
      <div class="card">Project 04</div>
    </div>
  </div>

  <footer>
    © 2026 Illustration Portfolio AI. Built with confidence.
  </footer>

</body>
</html>
